[Unit]
Description=Waveform Lab Web Telemetry & Scope Server
After=network.target

[Service]
Type=simple
User=cromero
WorkingDirectory=/home/cromero/raspberry3/projects/waveform-lab
ExecStart=/usr/bin/python3 /home/cromero/raspberry3/projects/waveform-lab/server.py --port 8080 --ssl-port 8443
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
